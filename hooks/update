#!/bin/sh

TOPLEVELDIR=$(git rev-parse --show-toplevel)

link_files() {
	srcdir="$1"
	destdir="$2"
	echo "Linking files from $srcdir to $destdir"
	find "$srcdir" -type f | while read -r srcfile; do
		relpath="${srcfile#"$srcdir"/}"
		# skip .gitconfig if it already exists in home
		if [ "$relpath" = ".gitconfig" ] && [ -f "$HOME/.gitconfig" ]; then
			echo "  Skipping $relpath (already exists in home)"
			continue
		fi
		# skip commands/ — synced as real copies below (provider resolves them)
		case "$relpath" in
			.config/opencode/commands/*)
				echo "  Skipping $relpath (managed by provider)"
				continue
				;;
			services/*)
				echo "  Skipping $relpath (managed by macos/install.sh)"
				continue
				;;
			install.sh)
				echo "  Skipping $relpath (run by the Darwin branch below)"
				continue
				;;
		esac
		destfile="$destdir/$relpath"
		# skip if any ancestor of dest is a symlink (prevents self-referencing
		# links when provider creates directory symlinks like ~/.config/pi)
		destdir_parent="$(dirname "$destfile")"
		while [ "$destdir_parent" != "$HOME" ] && [ "$destdir_parent" != "/" ]; do
			if [ -L "$destdir_parent" ]; then
				echo "  Skipping $relpath (ancestor is symlink)"
				continue 2
			fi
			destdir_parent="$(dirname "$destdir_parent")"
		done
		destdir_parent="$(dirname "$destfile")"
		if [ ! -d "$destdir_parent" ]; then
			echo "  Creating directory $destdir_parent"
			mkdir -p "$destdir_parent"
		fi
		# copy opencode plugins (opencode does not load symlinked plugin files)
		case "$relpath" in
			.config/opencode/plugins/*)
				rm -f "$destfile"
				echo "  $relpath -> $destfile (copy)"
				cp "$srcfile" "$destfile"
				continue
				;;
		esac
		echo "  $relpath -> $destfile"
		ln -sf "$srcfile" "$destfile"
	done
}

# Copy provider-managed template files (opencode commands, pi prompts) as
# real files, never links: provider resolves dynamic/* tokens in them, and
# a symlinked dest would redirect those writes into the repo.
# rsync --delete keeps structure in sync with the repo.
copy_files() {
	srcdir="$1"
	destdir="$2"
	[ -d "$srcdir" ] || return 0
	if ! command -v rsync >/dev/null 2>&1; then
		echo "  (rsync not found, skipping copy sync of $srcdir)" >&2
		return 0
	fi
	if [ -L "$destdir" ]; then
		echo "  Removing symlinked $destdir (replaced by real copies)"
		rm "$destdir"
	fi
	mkdir -p "$destdir"
	echo "Copying files from $srcdir to $destdir"
	rsync -a --delete "$srcdir"/ "$destdir"/
}

# Resolve a pnpm command, or echo a message and return 1 if unavailable.
_resolve_pnpm() {
	if command -v pnpm >/dev/null 2>&1; then
		echo "pnpm"
	elif command -v corepack >/dev/null 2>&1; then
		echo "corepack pnpm"
	else
		echo "  (pnpm not found, skipping install)" >&2
		return 1
	fi
}

# Install extension dependencies (pnpm install in permissions extension dir)
_pnpm_install() {
	if [ ! -f "$TOPLEVELDIR/common/.config/pi/extensions/permissions/pnpm-lock.yaml" ]; then
		return 0
	fi
	local pnpm_cmd
	pnpm_cmd="$(_resolve_pnpm)" || return 0
	echo "Installing permissions extension deps..."
	(cd "$TOPLEVELDIR/common/.config/pi/extensions/permissions" && $pnpm_cmd install --frozen-lockfile) || true
}

# Install plugin dependencies (pnpm install in opencode config dir, where
# plugins/ are linked and package.json declares @opencode-ai/plugin)
_pnpm_install_plugins() {
	local plugins_dest="$HOME/.config/opencode"
	if [ ! -f "$plugins_dest/package.json" ]; then
		return 0
	fi
	local pnpm_cmd
	pnpm_cmd="$(_resolve_pnpm)" || return 0
	echo "Installing opencode plugins deps..."
	(cd "$plugins_dest" && $pnpm_cmd install) || true
}

link_files "$TOPLEVELDIR/common" "$HOME"

if [ "$(uname -s)" != "Darwin" ]; then
	link_files "$TOPLEVELDIR/ossnix" "$HOME"
else
	if [ -d "$TOPLEVELDIR/macos" ]; then
		link_files "$TOPLEVELDIR/macos" "$HOME"
	else
		echo "No macos/ directory found, skipping"
	fi
	if [ -f "$TOPLEVELDIR/macos/install.sh" ]; then
		echo "Running macos installer..."
		sh "$TOPLEVELDIR/macos/install.sh" || true
	fi
fi

# Provider-managed templates: real copies, then re-resolve dynamic/* tokens
# with the last-deployed provider
copy_files "$TOPLEVELDIR/common/.config/opencode/commands" "$HOME/.config/opencode/commands"
copy_files "$TOPLEVELDIR/common/.config/pi/prompts" "$HOME/.pi/agent/prompts"

if [ -x "$HOME/.local/bin/provider" ]; then
	echo "Re-resolving provider templates..."
	"$HOME/.local/bin/provider" || true
fi

_pnpm_install
_pnpm_install_plugins
