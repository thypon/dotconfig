#!/usr/bin/env python3
# Resolve dynamic-models.jsonc provider into opencode.json + pi settings.json
# Usage: provider <prefix>
#   Fuzzy-matches provider name by first letters (e.g. "a" -> "anthropic")
#   Resolves dynamic/* tokens in template files and commands/prompts.

import json
import re
import sys
import os
import shutil
import socket
import subprocess
import urllib.request
import urllib.error
from functools import cmp_to_key


def find_repo_root():
    """Walk up from this script's real path to find the git repo root."""
    path = os.path.realpath(__file__)
    path = os.path.dirname(path)
    while path != "/":
        if os.path.isdir(os.path.join(path, ".git")):
            return path
        path = os.path.dirname(path)
    sys.exit("error: cannot find repo root")


REPO_ROOT = find_repo_root()

# Shared models (single source of truth)
MODELS_PATH = os.path.expanduser("~/.config/dynamic-models.jsonc")

# OpenCode paths
TEMPLATE_PATH = os.path.expanduser("~/.config/opencode/opencode.json.tmpl")
OUTPUT_PATH = os.path.expanduser("~/.config/opencode/opencode.json")

# DS4 local server (OpenAI-compatible DeepSeek V4 Flash)
DS4_HOST = "localhost"
DS4_PORT = 8000
DS4_MODEL_FLASH = "ds4/deepseek-v4-flash"
COMMANDS_SRC = os.path.join(REPO_ROOT, "common", ".config", "opencode", "commands")
COMMANDS_DST = os.path.expanduser("~/.config/opencode/commands")
OPENCODE_CONFIG_DIR = os.path.expanduser("~/.config/opencode")

# pi paths
PI_CONFIG_SRC = os.path.join(REPO_ROOT, "common", ".config", "pi")
PI_CONFIG_LINK = os.path.expanduser("~/.config/pi")
PI_SETTINGS_TMPL = os.path.join(PI_CONFIG_SRC, "settings.json.tmpl")
PI_SETTINGS_DST = os.path.expanduser("~/.pi/agent/settings.json")
PI_PROMPTS_SRC = os.path.join(PI_CONFIG_SRC, "prompts")
PI_PROMPTS_DST = os.path.expanduser("~/.pi/agent/prompts")
PI_SKILLS_DST = os.path.expanduser("~/.pi/agent/skills")
PI_EXTENSIONS_DST = os.path.expanduser("~/.pi/agent/extensions")
PI_EXTENSIONS_SRC = os.path.join(PI_CONFIG_SRC, "extensions")
SHARED_SKILLS = os.path.join(REPO_ROOT, "common", ".config", "skills")
OPENCODE_SKILLS = os.path.expanduser("~/.config/opencode/skills")


def strip_jsonc_comments(text):
    """Remove // and /* */ comments from JSONC, preserving strings."""
    pattern = r'"(?:[^"\\]|\\.)*"|//.*?$|/\*.*?\*/'
    def replacer(m):
        s = m.group(0)
        if s.startswith('"'):
            return s
        return ''
    return re.sub(pattern, replacer, text, flags=re.MULTILINE | re.DOTALL)


def load_jsonc(path):
    with open(path) as f:
        return json.loads(strip_jsonc_comments(f.read()))


def match_provider(providers, prefix):
    """Match provider by prefix. Returns (name, config) or exits with error."""
    prefix = prefix.lower()
    matches = [(k, v) for k, v in providers.items() if k.lower().startswith(prefix)]
    if len(matches) == 1:
        return matches[0]
    if len(matches) == 0:
        print(f"error: no provider matching '{prefix}'", file=sys.stderr)
        print(f"available: {', '.join(sorted(providers.keys()))}", file=sys.stderr)
        sys.exit(1)
    names = [m[0] for m in matches]
    print(f"error: ambiguous prefix '{prefix}' matches: {', '.join(names)}", file=sys.stderr)
    sys.exit(1)


def make_replacements(provider_config):
    small = provider_config["small_model"]
    if ds4_available() and "deepseek-v4-flash" in small:
        small = DS4_MODEL_FLASH
        print(f"  ds4: local server up, routing small_model -> {DS4_MODEL_FLASH}")
    return {
        "dynamic/provider": provider_config.get("name", ""),
        "dynamic/model": provider_config["model"],
        "dynamic/small_model": small,
        "dynamic/frontier_model": provider_config["frontier_model"],
        "dynamic/antagonist_model": provider_config["antagonist_model"],
    }


def ds4_available():
    """Probe DS4 local server (localhost:8000). Returns True if /v1/models responds."""
    try:
        with socket.create_connection((DS4_HOST, DS4_PORT), timeout=0.4) as _:
            pass
    except OSError:
        return False
    try:
        req = urllib.request.Request(f"http://{DS4_HOST}:{DS4_PORT}/v1/models", method="GET")
        with urllib.request.urlopen(req, timeout=1.0) as r:
            return r.status == 200
    except Exception:
        return False


def resolve_template(template, replacements):
    """Recursively replace string values that exactly match replacement keys."""
    def replace_in_obj(obj):
        if isinstance(obj, str):
            return replacements.get(obj, obj)
        if isinstance(obj, list):
            return [replace_in_obj(item) for item in obj]
        if isinstance(obj, dict):
            return {k: replace_in_obj(v) for k, v in obj.items()}
        return obj
    return replace_in_obj(template)


def resolve_text(text, replacements):
    """Replace all dynamic/* tokens in a plain text string."""
    for key, value in replacements.items():
        text = text.replace(key, value)
    return text


def ensure_dir(path):
    os.makedirs(path, exist_ok=True)


def ensure_symlink(target, link):
    """Create symlink if not exists. Replace wrong symlink or real dir."""
    if os.path.realpath(target) == os.path.realpath(link):
        return
    if os.path.islink(link):
        current = os.readlink(link)
        if current == target:
            return
        os.unlink(link)
    elif os.path.isdir(link):
        shutil.rmtree(link)
    elif os.path.exists(link):
        os.unlink(link)
    os.symlink(target, link)
    print(f"  linked: {link} -> {target}")


def resolve_and_copy(dir_src, dir_dst, replacements):
    """Copy dir_src to dir_dst, resolving dynamic/* tokens in all files.
    Never writes through symlinks: a symlinked dst is replaced by real copies."""
    if not os.path.isdir(dir_src):
        print(f"warning: source dir not found: {dir_src}", file=sys.stderr)
        return
    if os.path.islink(dir_dst):
        print(f"  unlink: {dir_dst} (symlink, replaced by real copies)")
        os.unlink(dir_dst)
    ensure_dir(dir_dst)
    for entry in os.listdir(dir_src):
        src = os.path.join(dir_src, entry)
        dst = os.path.join(dir_dst, entry)
        if os.path.isdir(src):
            if os.path.islink(dst):
                os.unlink(dst)
            resolve_and_copy(src, dst, replacements)
        else:
            if os.path.islink(dst):
                os.unlink(dst)
            with open(src) as f:
                content = f.read()
            resolved = resolve_text(content, replacements)
            with open(dst, "w") as f:
                f.write(resolved)
            print(f"  resolved: {dst}")


def setup_opencode(replacements):
    """Resolve opencode.json template and copy commands."""
    if not os.path.exists(TEMPLATE_PATH):
        print("warning: opencode.json.tmpl not found, skipping opencode setup", file=sys.stderr)
        return

    template = load_jsonc(TEMPLATE_PATH)
    result = resolve_template(template, replacements)

    with open(OUTPUT_PATH, "w") as f:
        json.dump(result, f, indent=2)
        f.write("\n")
    print(f"  resolved: {OUTPUT_PATH}")

    resolve_and_copy(COMMANDS_SRC, COMMANDS_DST, replacements)

    # Ensure skills symlink to shared
    ensure_symlink(SHARED_SKILLS, OPENCODE_SKILLS)


def setup_pi(replacements):
    # Ensure ~/.config/pi symlink to repo
    ensure_symlink(PI_CONFIG_SRC, PI_CONFIG_LINK)

    if not os.path.exists(PI_SETTINGS_TMPL):
        print("warning: pi settings.json.tmpl not found, skipping pi setup", file=sys.stderr)
        return

    template = load_jsonc(PI_SETTINGS_TMPL)
    result = resolve_template(template, replacements)

    ensure_dir(os.path.dirname(PI_SETTINGS_DST))
    with open(PI_SETTINGS_DST, "w") as f:
        json.dump(result, f, indent=2)
        f.write("\n")
    print(f"  resolved: {PI_SETTINGS_DST}")

    # Prompts are real copies (rsync'd by hooks/update); resolve dynamic/*
    # tokens in them. Copies, never links — provider writes must not touch repo.
    resolve_and_copy(PI_PROMPTS_SRC, PI_PROMPTS_DST, replacements)

    # Symlink skills → shared
    ensure_symlink(SHARED_SKILLS, PI_SKILLS_DST)

    # Symlink extensions → ~/.config/pi/extensions (which is repo symlink)
    ensure_symlink(PI_EXTENSIONS_SRC, PI_EXTENSIONS_DST)


# ---------------------------------------------------------------------------
# Update subcommand: bump model versions + opencode plugins to latest
# ---------------------------------------------------------------------------

# Dated version suffix (YYYYMMDD-ish) or dotted version, used to rank versions
# of the same model prefix. e.g. deepseek-v4-flash-0731 vs deepseek-v4-flash.
VERSION_RE = re.compile(r'(.*?)(?:[-.](\d{4,}))?$')

# Map known model prefix (sans version) -> human label, used for reporting only
# (no behaviour dependency; purely cosmetic)


def split_prefix_version(model_id):
    """Split 'deepseek-v4-flash-0731' -> ('deepseek-v4-flash', 731).
    Bare 'deepseek-v4-flash' -> ('deepseek-v4-flash', 0).
    'glm-5.3' -> ('glm-5', 3). 'gpt-5.6-terra' -> ('gpt-5.6-terra', 0)."""
    # try trailing -NNNN (4+ digits, dated)
    m = re.match(r'^(.*?)-(\d{4,})$', model_id)
    if m:
        return m.group(1), int(m.group(2))
    # try trailing .N (single trailing dotted component, numeric only)
    m = re.match(r'^(.*)\.(\d+)$', model_id)
    if m and m.group(2).isdigit():
        return m.group(1), int(m.group(2))
    return model_id, 0


def list_opencode_models():
    """Run `opencode models` once and return list of all model ids."""
    out = subprocess.run(["opencode", "models"], capture_output=True, text=True)
    if out.returncode != 0:
        print(f"error: opencode models failed: {out.stderr.strip()}", file=sys.stderr)
        return []
    return [ln.strip() for ln in out.stdout.splitlines() if ln.strip()]


_ALL_MODELS_CACHE = None
def all_opencode_models():
    global _ALL_MODELS_CACHE
    if _ALL_MODELS_CACHE is None:
        _ALL_MODELS_CACHE = list_opencode_models()
    return _ALL_MODELS_CACHE


def avail_for(model_id):
    """Return available model ids sharing the provider prefix of model_id."""
    prov = model_id.split('/', 1)[0]
    return [m for m in all_opencode_models() if m.split('/', 1)[0] == prov]


def latest_for_prefix(target):
    """Given a target id, find the latest version sharing the same prefix
    (minus version) among available models. Returns latest id or None."""
    tprefix, tver = split_prefix_version(target)
    tbase = tprefix.split('/', 1)[-1]
    candidates = []
    for m in avail_for(target):
        mprefix, mver = split_prefix_version(m)
        mbase = mprefix.split('/', 1)[-1]
        if mbase == tbase and mver >= tver:
            candidates.append((mver, m))
    if not candidates:
        return None
    candidates.sort(key=lambda x: x[0], reverse=True)
    return candidates[0][1]


def parse_model_refs(obj):
    """Yield (dict_path, key) for every leaf string under known model keys."""
    model_keys = {"model", "small_model", "frontier_model", "antagonist_model"}
    if isinstance(obj, dict):
        for k, v in obj.items():
            if k in model_keys and isinstance(v, str):
                yield obj, k
            else:
                yield from parse_model_refs(v)
    elif isinstance(obj, list):
        for item in obj:
            yield from parse_model_refs(item)


def update_models(apply):
    """Update dynamic-models.jsonc model versions to latest available per prefix."""
    models = load_jsonc(MODELS_PATH)
    providers = models["providers"]

    # collect every model id referenced
    all_refs = []
    for pname, pcfg in providers.items():
        for k in ("model", "small_model", "frontier_model", "antagonist_model"):
            v = pcfg.get(k)
            if isinstance(v, str):
                all_refs.append((pcfg, k, v))

    changes = []
    for pcfg, key, current in all_refs:
        latest = latest_for_prefix(current)
        if latest and latest != current:
            changes.append((current, latest))
            if apply:
                pcfg[key] = latest
        elif not latest:
            # not found in opencode models: keep current
            pass

    if not changes:
        print("models: all up to date")
        return

    print(f"models ({'apply' if apply else 'dry-run'}):")
    for old, new in changes:
        print(f"  {old}\n    -> {new}")

    if apply:
        with open(MODELS_PATH, "w") as f:
            # preserve the jsonc style as best-effort plain json
            json.dump(models, f, indent=4)
            f.write("\n")
        print(f"  written: {MODELS_PATH}")


def npm_latest(spec):
    """Resolve npm spec 'pkg@version' or 'pkg' -> latest version string."""
    pkg = spec.split('@', 1)[0] if spec.startswith('@') else spec.split('@', 1)[0]
    # handle scoped: @scope/pkg@ver
    if spec.startswith('@'):
        parts = spec.lstrip('@').split('@', 1)
        pkg = '@' + parts[0]
    try:
        out = subprocess.run(
            ["npm", "view", pkg, "version"],
            capture_output=True, text=True, timeout=15,
        )
        if out.returncode == 0:
            return out.stdout.strip()
    except Exception:
        pass
    return None


def update_plugins(apply):
    """Update opencode.json.tmpl plugin entries to latest npm versions."""
    template = load_jsonc(TEMPLATE_PATH)
    plugins = template.get("plugin", [])
    if not plugins:
        print("plugins: none configured")
        return

    changes = []
    for i, spec in enumerate(plugins):
        if not isinstance(spec, str) or '@' not in spec:
            continue
        # split pkg@version (handle scoped)
        if spec.startswith('@'):
            parts = spec.lstrip('@').rsplit('@', 1)
            pkg = '@' + parts[0]
            cur = parts[1] if len(parts) > 1 else ''
        else:
            pkg, _, cur = spec.partition('@')
        latest = npm_latest(spec)
        if latest and latest != cur:
            changes.append((i, spec, f"{pkg}@{latest}"))

    if not changes:
        print("plugins: all up to date")
        return

    print(f"plugins ({'apply' if apply else 'dry-run'}):")
    for _i, old, new in changes:
        print(f"  {old}\n    -> {new}")

    if apply:
        for i, _old, new in changes:
            plugins[i] = new
        with open(TEMPLATE_PATH, "w") as f:
            json.dump(template, f, indent=2)
            f.write("\n")
        print(f"  written: {TEMPLATE_PATH}")


def cmd_update():
    apply = "--apply" in sys.argv
    print("--- plugins ---")
    update_plugins(apply)
    print("\n--- models ---")
    update_models(apply)
    if not apply:
        print("\n(dry-run: pass --apply to write changes)")


def current_provider_name():
    """Return last-deployed provider name from pi settings.json, if any."""
    try:
        with open(PI_SETTINGS_DST) as f:
            name = json.load(f).get("defaultProvider")
        return name if isinstance(name, str) else None
    except (OSError, ValueError):
        return None


def main():
    if len(sys.argv) < 2:
        # Just ensure symlinks without provider resolution
        ensure_symlink(SHARED_SKILLS, OPENCODE_SKILLS)
        if os.path.exists(PI_CONFIG_SRC):
            ensure_symlink(PI_CONFIG_SRC, PI_CONFIG_LINK)
            ensure_symlink(SHARED_SKILLS, PI_SKILLS_DST)
            ensure_symlink(PI_EXTENSIONS_SRC, PI_EXTENSIONS_DST)

        try:
            models = load_jsonc(MODELS_PATH)
        except FileNotFoundError:
            print("error: dynamic-models.jsonc not found. Create symlink:", file=sys.stderr)
            print("  ln -s REPO/common/.config/dynamic-models.jsonc ~/.config/dynamic-models.jsonc", file=sys.stderr)
            sys.exit(1)

        providers = models["providers"]

        # No-arg = re-resolve with last-deployed provider (used by hooks/update)
        name = current_provider_name()
        if name and name in providers:
            print(f"re-resolving templates with current provider: {name}")
            config = providers[name]
            config["name"] = name
            replacements = make_replacements(config)

            print("--- opencode ---")
            setup_opencode(replacements)

            print("\n--- pi ---")
            setup_pi(replacements)
            return

        print(f"usage: provider <prefix>", file=sys.stderr)
        print(f"available: {', '.join(sorted(providers.keys()))}", file=sys.stderr)
        print(f"\nsymlinks created. Run with provider prefix to resolve templates.", file=sys.stderr)
        sys.exit(1)

    prefix = sys.argv[1]

    if prefix == "update":
        cmd_update()
        return

    # Ensure shared models symlink exists
    if not os.path.exists(MODELS_PATH):
        models_repo = os.path.join(REPO_ROOT, "common", ".config", "dynamic-models.jsonc")
        if os.path.exists(models_repo):
            ensure_symlink(models_repo, MODELS_PATH)

    models = load_jsonc(MODELS_PATH)
    providers = models["providers"]
    name, config = match_provider(providers, prefix)
    config["name"] = name
    replacements = make_replacements(config)

    print(f"--- opencode ---")
    setup_opencode(replacements)

    print(f"\n--- pi ---")
    setup_pi(replacements)

    print(f"\n{name}: model={config['model']} small={config['small_model']} frontier={config['frontier_model']} antagonist={config['antagonist_model']}")


if __name__ == "__main__":
    main()
