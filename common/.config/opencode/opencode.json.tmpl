{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "lsp": true,
  "default_agent": "plan",
  "model": "dynamic/model",
  "small_model": "dynamic/small_model",
  "provider": {
    "openrouter": {
      "options": {
        "timeout": 600000
      }
    },
    "ds4": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DS4 Local",
      "options": {
        "baseURL": "http://localhost:8000/v1",
        "apiKey": "ds4-local"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (local ds4)",
          "limit": {
            "context": 100000,
            "output": 32768
          }
        }
      }
    },
    "venice": {
      "models": {
        "olafangensan-glm-4.7-flash-heretic": {
          "limit": {
            "context": 128000,
            "output": 24000
          }
        }
      }
    },
    "amazon-bedrock": {
      "options": {
        "region": "us-west-2",
        "profile": "claude-code-bedrock-sso"
      },
      "models": {
        "claude-opus": {
          "id": "arn:aws:bedrock:us-west-2:168134825737:application-inference-profile/a4v3qtnkelgp",
          "name": "Claude Opus (Bedrock)"
        },
        "claude-sonnet": {
          "id": "arn:aws:bedrock:us-west-2:168134825737:application-inference-profile/i85wjhfzw5r3",
          "name": "Claude Sonnet (Bedrock)"
        },
        "claude-haiku": {
          "id": "arn:aws:bedrock:us-west-2:168134825737:application-inference-profile/u8agk44ql7te",
          "name": "Claude Haiku (Bedrock)"
        }
      }
    }
  },
  "agent": {
    "plan": {
      "mode": "primary",
      "model": "dynamic/frontier_model",
      "prompt": "{file:agents/plan.txt}",
      "options": {
        "sandbox": {
          "filesystem": {
            "denyRead": [
              "~/.ssh",
              "~/.gnupg",
              "~/.aws/credentials",
              "~/.azure",
              "~/.config/gcloud",
              "~/.config/gh",
              "~/.kube",
              "~/.docker/config.json",
              "~/.npmrc",
              "~/.netrc",
              "~/.env"
            ]
          },
          "network": {
            "allowedDomains": [
              "registry.npmjs.org",
              "*.npmjs.org",
              "registry.yarnpkg.com",
              "pypi.org",
              "*.pypi.org",
              "crates.io",
              "*.crates.io",
              "github.com",
              "*.github.com",
              "gitlab.com",
              "*.gitlab.com",
              "bitbucket.org",
              "*.bitbucket.org",
              "api.openai.com",
              "api.anthropic.com",
              "generativelanguage.googleapis.com",
              "*.googleapis.com",
              "openrouter.ai",
              "*.openrouter.ai",
              "api.bedrock.aws",
              "*.amazonaws.com",
              "api.venice.ai"
            ]
          }
        }
      },
      "permission": {
        "edit": "ask",
        "bash": {
          "*": "ask",
          "gh issue view*": "allow",
          "gh issue list*": "allow",
          "gh pr view*": "allow",
          "gh pr list*": "allow",
          "gh pr diff*": "allow",
          "gh pr checks*": "allow",
          "gh pr status*": "allow",
          "gh repo view*": "allow",
          "gh search *": "allow",
          "gh api --method GET *": "allow",
          "gh api *": "ask",
          "head *": "allow",
          "tail *": "allow",
          "cat *": "allow",
          "less *": "allow",
          "more *": "allow",
          "bat *": "allow",
          "grep *": "allow",
          "rg *": "allow",
          "ag *": "allow",
          "ack *": "allow",
          "sort *": "allow",
          "uniq *": "allow",
          "wc *": "allow",
          "cut *": "allow",
          "tr *": "allow",
          "awk *": "allow",
          "sed *": "allow",
          "jq *": "allow",
          "yq *": "allow",
          "xq *": "allow",
          "strings *": "allow",
          "od *": "allow",
          "hexdump *": "allow",
          "xxd *": "allow",
          "file *": "allow",
          "stat *": "allow",
          "ls *": "allow",
          "find *": "allow",
          "fd *": "allow",
          "tree *": "allow",
          "du *": "allow",
          "df *": "allow",
          "diff *": "allow",
          "comm *": "allow",
          "cmp *": "allow",
          "paste *": "allow",
          "column *": "allow",
          "expand *": "allow",
          "unexpand *": "allow",
          "fold *": "allow",
          "fmt *": "allow",
          "nl *": "allow",
          "tac *": "allow",
          "rev *": "allow",
          "shuf *": "allow",
          "split *": "allow",
          "csplit *": "allow",
          "tee *": "allow",
          "xargs *": "allow",
          "basename *": "allow",
          "dirname *": "allow",
          "realpath *": "allow",
          "readlink *": "allow",
          "test *": "allow",
          "[ *": "allow",
          "true": "allow",
          "false": "allow",
          "echo *": "allow",
          "printf *": "allow"
        },
        "external_directory": {
          "*": "ask"
        }
      }
    },
    "build": {
      "model": "dynamic/model"
    },
    "general": {
      "model": "dynamic/model"
    },
    "explore": {
      "model": "dynamic/small_model",
      "prompt": "{file:agents/explore.txt}"
    },
    "scout": {
      "model": "dynamic/small_model"
    },
    "review": {
      "description": "Read-only code review, caveman terse output",
      "mode": "primary",
      "model": "dynamic/antagonist_model",
      "prompt": "{file:agents/review.txt}",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "ask",
          "gh issue view*": "allow",
          "gh pr view*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "git status*": "allow",
          "rg *": "allow",
          "grep *": "allow"
        }
      }
    },
    "compaction": {
      "model": "dynamic/small_model"
    },
    "title": {
      "model": "dynamic/small_model"
    }
  },
  "plugin": [
    "./plugins/sandbox-config.ts",
    "@tarquinen/opencode-dcp@3.1.14",
    "opencode-sandbox@0.3.2"
  ]
}
