{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "default_agent": "plan",
  "model": "dynamic/model",
  "providers": {
    "openrouter": {
      "settings": {
        "timeout": 600000
      }
    },
    "ds4": {
      "name": "DS4 Local",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://localhost:8000/v1",
        "apiKey": "ds4-local"
      },
      "models": {
        "glm-5.3-flash": {
          "name": "GLM 5.3 Flash (local ds4)",
          "limit": {
            "context": 100000,
            "output": 32768
          }
        }
      }
    },
    "venice": {
      "models": {
        "olafangensan-glm-4.7-flash-heretic": {
          "limit": {
            "context": 128000,
            "output": 24000
          }
        }
      }
    },
    "amazon-bedrock": {
      "settings": {
        "region": "us-west-2",
        "profile": "claude-code-bedrock-sso"
      },
      "models": {
        "claude-opus": {
          "modelID": "arn:aws:bedrock:us-west-2:168134825737:application-inference-profile/a4v3qtnkelgp",
          "name": "Claude Opus (Bedrock)"
        },
        "claude-sonnet": {
          "modelID": "arn:aws:bedrock:us-west-2:168134825737:application-inference-profile/i85wjhfzw5r3",
          "name": "Claude Sonnet (Bedrock)"
        },
        "claude-haiku": {
          "modelID": "arn:aws:bedrock:us-west-2:168134825737:application-inference-profile/u8agk44ql7te",
          "name": "Claude Haiku (Bedrock)"
        }
      }
    }
  },
  "agents": {
    "plan": {
      "mode": "primary",
      "model": "dynamic/frontier_model",
      "system": "{file:agents/plan.txt}",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "gh issue view*", "effect": "allow" },
        { "action": "shell", "resource": "gh issue list*", "effect": "allow" },
        { "action": "shell", "resource": "gh pr view*", "effect": "allow" },
        { "action": "shell", "resource": "gh pr list*", "effect": "allow" },
        { "action": "shell", "resource": "gh pr diff*", "effect": "allow" },
